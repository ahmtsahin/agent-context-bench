{
  "name": "agent-context-bench",
  "version": "0.6.0",
  "description": "Lint agent context files and A/B benchmark whether they help or slow down coding agents.",
  "type": "module",
  "author": "Ahmet Sahin (https://github.com/ahmtsahin)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmtsahin/agent-context-bench.git"
  },
  "bugs": {
    "url": "https://github.com/ahmtsahin/agent-context-bench/issues"
  },
  "homepage": "https://github.com/ahmtsahin/agent-context-bench#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-context-bench": "./dist/cli.js",
    "context-diet": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "action.yml"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "smoke": "node dist/cli.js --help",
    "docs:dashboard": "npm run build && node scripts/generate-demo-dashboard.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "agents-md",
    "claude-code",
    "codex",
    "cursor",
    "ai-coding-agents",
    "context-engineering",
    "benchmark",
    "linter",
    "coding-agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "gpt-tokenizer": "^2.9.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "gpt-tokenizer": "^2.9.0"
  },
  "peerDependenciesMeta": {
    "gpt-tokenizer": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
